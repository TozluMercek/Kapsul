<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon for one-tap capture. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutId="quick_note"
        android:shortcutLongLabel="@string/shortcut_quick_note_long"
        android:shortcutShortLabel="@string/shortcut_quick_note">
        <intent
            android:action="com.example.kapsul.action.QUICK_NOTE"
            android:targetClass="com.example.kapsul.MainActivity"
            android:targetPackage="com.example.kapsul" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutId="voice_note"
        android:shortcutLongLabel="@string/shortcut_voice_note_long"
        android:shortcutShortLabel="@string/shortcut_voice_note">
        <intent
            android:action="com.example.kapsul.action.VOICE_NOTE"
            android:targetClass="com.example.kapsul.MainActivity"
            android:targetPackage="com.example.kapsul" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_ask"
        android:shortcutId="ask"
        android:shortcutLongLabel="@string/shortcut_ask_long"
        android:shortcutShortLabel="@string/shortcut_ask">
        <intent
            android:action="com.example.kapsul.action.ASK"
            android:targetClass="com.example.kapsul.MainActivity"
            android:targetPackage="com.example.kapsul" />
    </shortcut>
</shortcuts>
